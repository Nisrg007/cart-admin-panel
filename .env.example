# Production Environment Variables (for your Vercel backend)
VITE_API_BASE_URL=https://your-backend-app.vercel.app

# Your Mapbox access token
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Admin API key (should match your backend's ADMIN_API_KEY)
VITE_ADMIN_API_KEY=your_admin_api_key_here

# Development Environment Variables (local development)
# VITE_API_BASE_URL=http://localhost:3000
# VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here  
# VITE_ADMIN_API_KEY=your_admin_api_key_here